{
  "manifestVersion": 1,
  "id": "aging-wip",
  "publisher": "TomaszZelezny",
  "version": "1.1.3",
  "name": "Aging WIP",
  "description": "Aging WIP chart for Azure Boards: how old every open work item is and how long it has been in its current state.",
  "public": false,
  "galleryFlags": ["Preview"],
  "categories": ["Azure Boards"],
  "tags": ["aging", "wip", "flow", "kanban", "metrics"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "img/logo.png" },
  "content": {
    "details": { "path": "overview.md" },
    "license": { "path": "LICENSE" }
  },
  "screenshots": [
    { "path": "img/screenshots/hub.png" },
    { "path": "img/screenshots/widget.png" },
    { "path": "img/screenshots/hub-dark.png" }
  ],
  "repository": { "type": "git", "uri": "https://github.com/tomaszzelezny/azure-devops" },
  "links": {
    "getstarted": { "uri": "https://github.com/tomaszzelezny/azure-devops#readme" },
    "support": { "uri": "https://github.com/tomaszzelezny/azure-devops/issues" },
    "license": { "uri": "https://github.com/tomaszzelezny/azure-devops/blob/main/LICENSE" },
    "privacypolicy": { "uri": "https://github.com/tomaszzelezny/azure-devops/blob/main/PRIVACY.md" }
  },
  "CustomerQnASupport": { "enableqna": true, "url": "https://github.com/tomaszzelezny/azure-devops/issues" },
  "scopes": ["vso.work", "vso.project"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "img", "addressable": true }
  ],
  "contributions": [
    {
      "id": "aging-wip-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-work-web.work-hub-group"],
      "properties": {
        "name": "Aging WIP",
        "uri": "dist/hub.html",
        "iconName": "Chart",
        "order": 100
      }
    },
    {
      "id": "aging-wip-widget",
      "type": "ms.vss-dashboards-web.widget",
      "targets": ["ms.vss-dashboards-web.widget-catalog", ".aging-wip-widget-config"],
      "properties": {
        "name": "Aging WIP",
        "description": "Open work items by age and days in the current state.",
        "catalogIconUrl": "img/logo.png",
        "previewImageUrl": "img/logo.png",
        "uri": "dist/widget.html",
        "isNameConfigurable": true,
        "supportedSizes": [
          { "rowSpan": 2, "columnSpan": 2 },
          { "rowSpan": 2, "columnSpan": 3 },
          { "rowSpan": 3, "columnSpan": 3 },
          { "rowSpan": 3, "columnSpan": 4 },
          { "rowSpan": 4, "columnSpan": 4 },
          { "rowSpan": 4, "columnSpan": 6 }
        ],
        "supportedScopes": ["project_team"]
      }
    },
    {
      "id": "aging-wip-widget-config",
      "type": "ms.vss-dashboards-web.widget-configuration",
      "targets": ["ms.vss-dashboards-web.widget-configuration"],
      "properties": {
        "name": "Aging WIP configuration",
        "uri": "dist/config.html"
      }
    }
  ]
}
